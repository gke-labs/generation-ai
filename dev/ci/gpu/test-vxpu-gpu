set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# Read the torch pin from vxpu/images/executor/Dockerfile so both environments stay in sync.
# The executor image and this runner job must use the same torch version.
TORCH_VERSION="$(sed -n 's/.*torch==\([0-9.]*\).*/\1/p' vxpu/images/executor/Dockerfile)"
if [ -z "${TORCH_VERSION}" ]; then
  echo "no torch pin found in vxpu/images/executor/Dockerfile" >&2
  exit 1
fi

export UV_CACHE_DIR="${REPO_ROOT}/.cache/uv"

# Install uv from a pinned release into a repo cache directory, verifying checksum.
UV_VERSION="0.13.8"
UV_SHA256="5acfd9177cfecf0bf87578f059728215ccc884388988f55f7a65041b57387d91"
UV_DIR="${REPO_ROOT}/.cache/bin"
if [ ! -x "${UV_DIR}/uv" ]; then
  mkdir -p "${UV_DIR}"
  UV_TARBALL="${UV_DIR}/uv-${UV_VERSION}.tar.gz"
  curl -sSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" -o "${UV_TARBALL}"
  echo "${UV_SHA256}  ${UV_TARBALL}" | sha256sum -c -
  tar -xz -C "${UV_DIR}" --strip-components=1 -f "${UV_TARBALL}" uv-x86_64-unknown-linux-gnu/uv
  rm -f "${UV_TARBALL}"
fi
export PATH="${UV_DIR}:${PATH}"

# Create virtual environment; uv will download Python 3.13 if not present.
uv venv --python 3.13
source .venv/bin/activate

# Install the CUDA build of torch (the default Linux wheel on PyPI) and vxpu in editable mode.
uv pip install "torch==${TORCH_VERSION}"
uv pip install -e vxpu/python

# Print GPU information.
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi
fi

# Fail at once with a clear message if torch.cuda.is_available() is false.
if ! python -c "import torch, sys; sys.exit(0 if torch.cuda.is_available() else 1)"; then
  echo "CUDA is not available: torch.cuda.is_available() returned False" >&2
  exit 1
fi

# Run unittest discovery across vxpu/python from the repository root.
# Tests that skip without CUDA now run.
python -m unittest discover -s vxpu/python -p '*_test.py' -v
