set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# Check out the pinned deepseek_v41 submodule for tests that use tiny DeepSeek.
git submodule update --init vxpu/third_party/deepseek_v41

# Fail if the model source is absent instead of skipping tests that need it.
if [ ! -f "vxpu/third_party/deepseek_v41/inference/model.py" ]; then
  echo "Error: deepseek_v41 model source is absent (expected at vxpu/third_party/deepseek_v41/inference/model.py)" >&2
  exit 1
fi

# GKE mounts the NVIDIA driver and tools under /usr/local/nvidia.
# Export PATH, LD_LIBRARY_PATH, and LIBRARY_PATH so the shell, Python, dynamic linker,
# and C++ compilers (building extensions/Inductor kernels) see nvidia-smi and driver libraries.
export PATH="/usr/local/nvidia/bin:${PATH}"
export LD_LIBRARY_PATH="/usr/local/nvidia/lib64:/usr/local/nvidia/lib:${LD_LIBRARY_PATH:-}"
export LIBRARY_PATH="/usr/local/nvidia/lib64:/usr/local/nvidia/lib:${LIBRARY_PATH:-}"

# Read the torch pin from vxpu/images/executor/Dockerfile so both environments stay in sync.
# The executor image and this runner job must use the same torch version.
TORCH_VERSION="$(sed -n 's/.*torch==\([0-9.]*\).*/\1/p' vxpu/images/executor/Dockerfile | head -1)"
if [ -z "${TORCH_VERSION}" ]; then
  echo "no torch pin found in vxpu/images/executor/Dockerfile" >&2
  exit 1
fi

# Pre-flight GPU diagnostics before downloading packages.
# Determine which driver the node has, what the pod can see of it, and what torch wanted.
NODE_DRIVER=""
if [ -f /proc/driver/nvidia/version ]; then
  NODE_DRIVER="$(sed -n 's/.* \([0-9]\+\.[0-9]\+\(\.[0-9]\+\)\?\).*/\1/p' /proc/driver/nvidia/version | head -1)"
fi

echo "=== GPU Environment ==="
if [ -n "${NODE_DRIVER}" ]; then
  echo "Node driver: ${NODE_DRIVER}"
else
  echo "Node driver: not detected (/proc/driver/nvidia/version missing)"
fi
echo "Driver libraries in pod: $(ls -d /usr/local/nvidia/lib64 2>/dev/null || echo 'none')"
echo "Devices in pod: $(ls -d /dev/nvidia* 2>/dev/null | tr '\n' ' ' || echo 'none')"
echo "Torch requirement: torch==${TORCH_VERSION} (requires CUDA 13, driver >= 580)"

# Check 1: device presence in container.
# If no device was allocated to the pod, fail before downloading large packages.
if [ ! -e /dev/nvidia0 ] && [ ! -e /dev/nvidiactl ]; then
  echo "GPU pre-flight check failed: no device (/dev/nvidia0 not present in container)." >&2
  echo "Node driver: ${NODE_DRIVER:-unknown}" >&2
  echo "Torch wanted: torch==${TORCH_VERSION} (requires CUDA 13, driver >= 580)" >&2
  exit 1
fi

# Check 2: driver files mounted in container.
# GKE mounts driver user-space libraries under /usr/local/nvidia/lib64.
if [ ! -e /usr/local/nvidia/lib64/libcuda.so.1 ] && [ ! -e /usr/lib/x86_64-linux-gnu/libcuda.so.1 ]; then
  echo "GPU pre-flight check failed: no driver files in the pod (/usr/local/nvidia/lib64/libcuda.so.1 not found)." >&2
  echo "Node driver: ${NODE_DRIVER:-unknown}" >&2
  echo "Torch wanted: torch==${TORCH_VERSION} (requires CUDA 13, driver >= 580)" >&2
  exit 1
fi

# Check 3: driver version compatibility with torch.
# Torch 2.14.1 is built for CUDA 13, which requires NVIDIA driver >= 580.
if [ -n "${NODE_DRIVER}" ]; then
  DRIVER_MAJOR="${NODE_DRIVER%%.*}"
  if [ -n "${DRIVER_MAJOR}" ] && [ "${DRIVER_MAJOR}" -lt 580 ]; then
    echo "GPU pre-flight check failed: driver too old for this torch: node driver is ${NODE_DRIVER}, but torch ${TORCH_VERSION} requires CUDA 13 (driver >= 580)." >&2
    exit 1
  fi
fi

# Print GPU information via nvidia-smi if available.
if command -v nvidia-smi >/dev/null 2>&1; then
  nvidia-smi
fi

export UV_CACHE_DIR="${REPO_ROOT}/.cache/uv"
export UV_PYTHON_INSTALL_DIR="${REPO_ROOT}/.cache/python"

# Install uv from a pinned release into a repo cache directory, verifying checksum.
UV_VERSION="0.13.8"
UV_SHA256="5acfd9177cfecf0bf87578f059728215ccc884388988f55f7a65041b57387d91"
UV_DIR="${REPO_ROOT}/.cache/bin"
if [ ! -x "${UV_DIR}/uv" ]; then
  mkdir -p "${UV_DIR}"
  UV_TARBALL="${UV_DIR}/uv-${UV_VERSION}.tar.gz"
  curl -sSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" -o "${UV_TARBALL}"
  echo "${UV_SHA256}  ${UV_TARBALL}" | sha256sum -c -
  tar -xz -C "${UV_DIR}" --strip-components=1 -f "${UV_TARBALL}" uv-x86_64-unknown-linux-gnu/uv
  rm -f "${UV_TARBALL}"
fi
export PATH="${UV_DIR}:${PATH}"

# Install Go from a pinned release into the cache directory, verifying checksum.
GO_VERSION="1.27.4"
GO_SHA256="7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840"
GO_DIR="${REPO_ROOT}/.cache/go"
if [ ! -x "${GO_DIR}/bin/go" ]; then
  mkdir -p "${REPO_ROOT}/.cache"
  GO_TARBALL="${REPO_ROOT}/.cache/go${GO_VERSION}.linux-amd64.tar.gz"
  curl -sSL "https://dl.google.com/go/go${GO_VERSION}.linux-amd64.tar.gz" -o "${GO_TARBALL}"
  echo "${GO_SHA256}  ${GO_TARBALL}" | sha256sum -c -
  tar -xz -C "${REPO_ROOT}/.cache" -f "${GO_TARBALL}"
  rm -f "${GO_TARBALL}"
fi
export PATH="${GO_DIR}/bin:${PATH}"

# Compile vxpu, vxpu-agent, vxpu-router, and modelstore binaries into PATH on every run
# so tests run against the current pull request's code.
# Kept in /tmp (outside .cache) so build products are not saved into the Actions cache.
BUILD_BIN_DIR="/tmp/bin"
mkdir -p "${BUILD_BIN_DIR}"
TREE_COMMIT="$(git rev-parse HEAD)"
(cd "${REPO_ROOT}/vxpu" && \
  go build -buildvcs=false -o "${BUILD_BIN_DIR}/vxpu" ./cmd/vxpu && \
  go build -buildvcs=false -ldflags "-X main.softwareVersion=${TREE_COMMIT}" -o "${BUILD_BIN_DIR}/vxpu-agent" ./cmd/vxpu-agent && \
  go build -buildvcs=false -o "${BUILD_BIN_DIR}/vxpu-router" ./cmd/vxpu-router)
(cd "${REPO_ROOT}/modelstore" && go build -buildvcs=false -o "${BUILD_BIN_DIR}/modelstore" ./cmd/modelstore)
export PATH="${BUILD_BIN_DIR}:${PATH}"

# Create virtual environment; uv will download Python 3.13 if not present.
uv venv --python 3.13
source .venv/bin/activate

# Install the CUDA build of torch (the default Linux wheel on PyPI) and vxpu in editable mode.
echo "Installing PyTorch ${TORCH_VERSION} and CUDA dependencies via uv..."
uv pip install "torch==${TORCH_VERSION}"
uv pip install -e vxpu/python
uv pip install "cuda-toolkit[all]"
echo "Dependencies installed successfully."

# Locate CUDA installation in the virtual environment for torch Inductor C++ compilation.
SITE_PACKAGES="$(python -c 'import site; print(site.getsitepackages()[0])')"
if [ -d "${SITE_PACKAGES}/nvidia/cu13" ]; then
  export CUDA_HOME="${SITE_PACKAGES}/nvidia/cu13"
elif [ -d "/usr/local/cuda" ]; then
  export CUDA_HOME="/usr/local/cuda"
fi

# Fail at once with a clear message if torch.cuda.is_available() is false.
if ! python -c "import torch, sys; sys.exit(0 if torch.cuda.is_available() else 1)"; then
  echo "CUDA is not available: torch.cuda.is_available() returned False" >&2
  exit 1
fi

python -c 'import torch; print(f"Torch CUDA available: {torch.cuda.is_available()}, device: {torch.cuda.get_device_name(0)}, capability: {torch.cuda.get_device_capability(0)}")'

# Require model source for tests that need it; tests will fail rather than skip.
export VXPU_REQUIRE_MODEL_SOURCE="1"

# Share an AOTInductor package cache across test loads within this job run.
# Kept in /tmp (outside .cache) so it is fresh per runner pod and not saved to the Actions cache.
export VXPU_TEST_AOTI_CACHE_DIR="/tmp/vxpu-aoti-cache"
rm -rf "${VXPU_TEST_AOTI_CACHE_DIR}"
mkdir -p "${VXPU_TEST_AOTI_CACHE_DIR}"

# Do not write bytecode into submodules and unbuffer test output.
export PYTHONDONTWRITEBYTECODE="1"
export PYTHONUNBUFFERED="1"

# Fetch test models once into .cache/hf-mirror (preserved by the workflow cache)
# and serve them from the local HTTP mirror so tests do not reach huggingface.co.
source "${REPO_ROOT}/dev/ci/hf_mirror_env.sh"
start_hf_mirror "${REPO_ROOT}/.cache/hf-mirror" python

# Run the 4-step Hero Journey on the L4 GPU against local modelstore, vxpu-agent,
# and vxpu-router processes (no Kubernetes cluster required).
HERO_TMP="$(mktemp -d "${TMPDIR:-/tmp}/vxpu-hero-gpu.XXXXXX")"
HERO_MODELSTORE_PID=""
HERO_AGENT_PID=""
HERO_ROUTER_PID=""

stop_hero_services() {
  local pid
  for pid in "${HERO_ROUTER_PID:-}" "${HERO_AGENT_PID:-}" "${HERO_MODELSTORE_PID:-}"; do
    if [ -n "${pid}" ]; then
      kill "${pid}" 2>/dev/null || true
      wait "${pid}" 2>/dev/null || true
    fi
  done
  HERO_ROUTER_PID=""
  HERO_AGENT_PID=""
  HERO_MODELSTORE_PID=""
}

cleanup_gpu_test() {
  stop_hero_services
  if [ -n "${HERO_TMP:-}" ]; then
    rm -rf "${HERO_TMP}"
    HERO_TMP=""
  fi
  stop_hf_mirror
}
trap cleanup_gpu_test EXIT

wait_for_tcp() {
  local name="$1"
  local port="$2"
  local pid="$3"
  local log_file="$4"
  local i
  for i in $(seq 1 150); do
    if python -c "import socket, sys; s = socket.create_connection(('127.0.0.1', int(sys.argv[1])), 0.2); s.close()" "${port}" 2>/dev/null; then
      return 0
    fi
    if ! kill -0 "${pid}" 2>/dev/null; then
      echo "Error: ${name} exited before listening on 127.0.0.1:${port}" >&2
      cat "${log_file}" >&2 || true
      return 1
    fi
    sleep 0.2
  done
  echo "Error: ${name} did not listen on 127.0.0.1:${port} within 30s" >&2
  cat "${log_file}" >&2 || true
  return 1
}

read -r MODELSTORE_PORT AGENT_PORT ROUTER_PORT < <(python -c '
import socket
socks = []
ports = []
for _ in range(3):
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    ports.append(str(s.getsockname()[1]))
    socks.append(s)
for s in socks:
    s.close()
print(" ".join(ports))
')

MODELSTORE_URL="http://127.0.0.1:${MODELSTORE_PORT}"
AGENT_ADDR="127.0.0.1:${AGENT_PORT}"
ROUTER_ADDR="127.0.0.1:${ROUTER_PORT}"

mkdir -p "${HERO_TMP}/blobs" "${HERO_TMP}/mounts" "${HERO_TMP}/agent-work"

modelstore serve \
  --port "${MODELSTORE_PORT}" \
  --blob-store "${HERO_TMP}/blobs" \
  --hf-endpoint "${HF_ENDPOINT}" \
  > "${HERO_TMP}/modelstore.log" 2>&1 &
HERO_MODELSTORE_PID=$!
wait_for_tcp "modelstore" "${MODELSTORE_PORT}" "${HERO_MODELSTORE_PID}" "${HERO_TMP}/modelstore.log"

vxpu-agent \
  --port "${AGENT_PORT}" \
  --host 127.0.0.1 \
  --mount-root "${HERO_TMP}/mounts" \
  --work-root "${HERO_TMP}/agent-work" \
  --store "${MODELSTORE_URL}" \
  > "${HERO_TMP}/agent.log" 2>&1 &
HERO_AGENT_PID=$!
wait_for_tcp "vxpu-agent" "${AGENT_PORT}" "${HERO_AGENT_PID}" "${HERO_TMP}/agent.log"

vxpu-router \
  --port "${ROUTER_PORT}" \
  --agent "${AGENT_ADDR}" \
  --modelstore "${MODELSTORE_URL}" \
  --accelerator nvidia-l4 \
  > "${HERO_TMP}/router.log" 2>&1 &
HERO_ROUTER_PID=$!
wait_for_tcp "vxpu-router" "${ROUTER_PORT}" "${HERO_ROUTER_PID}" "${HERO_TMP}/router.log"

MACHINE_KIND="gpu:$(python -c 'import torch; print(torch.cuda.get_device_name(0).strip().lower())')"
echo "=== Running 4-step Hero Journey on ${MACHINE_KIND} (software_version=${TREE_COMMIT}) ==="

if ! python -u "${REPO_ROOT}/vxpu/tests/e2e/hero_test.py" \
  --router "${ROUTER_ADDR}" \
  --agent "${AGENT_ADDR}" \
  --artifact-dir "${HERO_TMP}/artifact" \
  --vxpu-bin "${BUILD_BIN_DIR}/vxpu" \
  --modelstore "${MODELSTORE_URL}" \
  --machine-kind "${MACHINE_KIND}" \
  --software-version "${TREE_COMMIT}"; then
  echo "=== modelstore.log ===" >&2
  cat "${HERO_TMP}/modelstore.log" >&2 || true
  echo "=== agent.log ===" >&2
  cat "${HERO_TMP}/agent.log" >&2 || true
  echo "=== router.log ===" >&2
  cat "${HERO_TMP}/router.log" >&2 || true
  exit 1
fi

stop_hero_services
rm -rf "${HERO_TMP}"
HERO_TMP=""

# Run test discovery from the repository root.
# The test runner prints each test as it starts and summarizes skipped tests with their reasons.
# Tests that skip without CUDA now run.
python -u dev/ci/test_runner.py

# Run acceptance test for CompilerClient through real agent and service on L4 GPU.
# In this job a skip or failure is fatal.
if ! (cd "${REPO_ROOT}/vxpu" && go test -v -count=1 -run TestCompilerClient ./pkg/kernelplan) > /tmp/compiler_client_gpu_test.out 2>&1; then
  cat /tmp/compiler_client_gpu_test.out
  echo "Error: TestCompilerClient on GPU did not pass" >&2
  exit 1
fi
cat /tmp/compiler_client_gpu_test.out
if ! grep -F -q -e "--- PASS: TestCompilerClient_ThroughRealAgentAndService" /tmp/compiler_client_gpu_test.out; then
  echo "Error: TestCompilerClient_ThroughRealAgentAndService did not pass" >&2
  exit 1
fi
rm -f /tmp/compiler_client_gpu_test.out

# Run acceptance test for vxpu plan packages --build through real agent and service on L4 GPU.
# In this job a skip or failure is fatal.
if ! (cd "${REPO_ROOT}/vxpu" && go test -v -count=1 -run TestCmdPlanPackages_Build ./cmd/vxpu) > /tmp/plan_packages_build_gpu_test.out 2>&1; then
  cat /tmp/plan_packages_build_gpu_test.out
  echo "Error: TestCmdPlanPackages_Build on GPU did not pass" >&2
  exit 1
fi
cat /tmp/plan_packages_build_gpu_test.out
if ! grep -F -q -e "--- PASS: TestCmdPlanPackages_BuildThroughService" /tmp/plan_packages_build_gpu_test.out; then
  echo "Error: TestCmdPlanPackages_BuildThroughService did not pass" >&2
  exit 1
fi
rm -f /tmp/plan_packages_build_gpu_test.out

# Run acceptance test for segment reads and writes invariants on tiny DeepSeek and tiny Llama.
# In this job a skip or failure is fatal.
if ! (cd "${REPO_ROOT}/vxpu" && go test -v -count=1 -run "TestReadSegments_ReadsWrites_Tiny" ./pkg/kernelplan) > /tmp/reads_writes_gpu_test.out 2>&1; then
  cat /tmp/reads_writes_gpu_test.out
  echo "Error: TestReadSegments_ReadsWrites_Tiny on GPU did not pass" >&2
  exit 1
fi
cat /tmp/reads_writes_gpu_test.out
if ! grep -F -q -e "--- PASS: TestReadSegments_ReadsWrites_TinyDeepSeek" /tmp/reads_writes_gpu_test.out || \
   ! grep -F -q -e "--- PASS: TestReadSegments_ReadsWrites_TinyLlama" /tmp/reads_writes_gpu_test.out; then
  echo "Error: TestReadSegments_ReadsWrites_Tiny on GPU skipped or did not pass" >&2
  exit 1
fi
rm -f /tmp/reads_writes_gpu_test.out

# Run acceptance test for plan emit on tiny DeepSeek (CPU and GPU package keys, tree, and identity).
# In this job a skip or failure is fatal.
if ! (cd "${REPO_ROOT}/vxpu" && go test -v -count=1 -run "^TestCmdPlanEmit_TinyDeepSeek$" ./cmd/vxpu) > /tmp/plan_emit_tiny_deepseek_gpu_test.out 2>&1; then
  cat /tmp/plan_emit_tiny_deepseek_gpu_test.out
  echo "Error: TestCmdPlanEmit_TinyDeepSeek on GPU did not pass" >&2
  exit 1
fi
cat /tmp/plan_emit_tiny_deepseek_gpu_test.out
if ! grep -F -q -e "--- PASS: TestCmdPlanEmit_TinyDeepSeek" /tmp/plan_emit_tiny_deepseek_gpu_test.out; then
  echo "Error: TestCmdPlanEmit_TinyDeepSeek on GPU skipped or did not pass" >&2
  exit 1
fi
rm -f /tmp/plan_emit_tiny_deepseek_gpu_test.out

# Print the read op's kernel-check line on the runner's GPU card.
python -m vxpu.kernel_tools.check vxpu::read gpu_triton --shapes 268435456 --device cuda
