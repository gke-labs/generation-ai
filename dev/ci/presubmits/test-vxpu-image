set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# Initialize submodules for build context so Docker COPY has all sources.
git submodule update --init vxpu/third_party/transformers vxpu/third_party/deepseek_v41

# Build the executor image stamped with the repository's HEAD commit.
TREE_COMMIT="$(git rev-parse HEAD)"
docker build --build-arg "TREE_COMMIT=${TREE_COMMIT}" -t vxpu-executor:e2e -f vxpu/images/executor/Dockerfile .

# Fetch test models once and serve them from a local HTTP mirror on loopback so
# container test runs do not reach huggingface.co.
source "${REPO_ROOT}/dev/ci/hf_mirror_env.sh"
start_hf_mirror "${REPO_ROOT}/.cache/hf-mirror" python3

# The equivalence harness's CI tier: tiny models exported from a
# local directory and from the Hub, run on the in-process engine,
# token-exact against eager transformers.
echo "Running the test-vectors selftest in the executor image"
docker run --rm --network=host -e "HF_ENDPOINT=${HF_ENDPOINT}" \
  --entrypoint python vxpu-executor:e2e \
  -m vxpu.vectors_test selftest --workdir /tmp/vectors

# Fast smoke check inside the shipped container: verify vxpu imports,
# prebuilt C++ CPU kernels load from TORCH_EXTENSIONS_DIR without compiling,
# and the fast kernel unit tests pass.
echo "Running the prebuilt-kernel smoke check in the executor image"
docker run --rm --entrypoint python vxpu-executor:e2e -c '
import glob, os
import vxpu, vxpu.kernels as k

ext_dir = os.environ["TORCH_EXTENSIONS_DIR"]
prebuilt = sorted(glob.glob(os.path.join(ext_dir, "**", "vxpu_fp4_kernels*.so"), recursive=True))
assert prebuilt, f"no prebuilt vxpu_fp4_kernels .so under {ext_dir}"
before = {os.path.realpath(p): (os.stat(p).st_ino, os.stat(p).st_mtime_ns) for p in prebuilt}

mod = k.load()
assert mod is not None, f"kernels.load() failed: {k.why_not()}"
loaded = os.path.realpath(mod.__file__)
assert loaded in before, f"loaded extension {loaded} was not in prebuilt set {sorted(before)}"
st = os.stat(loaded)
assert (st.st_ino, st.st_mtime_ns) == before[loaded], f"prebuilt extension {loaded} was rebuilt at runtime"
print(f"Prebuilt C++ kernels loaded without compiling: {loaded}")
'
docker run --rm --entrypoint python vxpu-executor:e2e \
  -m unittest -v vxpu.allreduce_test vxpu.rotary_test vxpu.kernels.read.read_test vxpu.kernels_test

# Kernel check for physical variants against their reference.
echo "Running the kernel check in the executor image"
docker run --rm --entrypoint python vxpu-executor:e2e \
  -m vxpu.kernel_tools.check "vxpu::fp8_linear" "bf16_dequant" \
  --shapes "1x128->64" --shapes "4x128->256" \
  --device cpu --bandwidth-gb-s 100 --floor-basis nominal

# Kernel score across ops and shapes.
echo "Running the kernel score in the executor image"
SCORE_OUT="$(docker run --rm --entrypoint python vxpu-executor:e2e \
  -m vxpu.kernel_tools.score)"
echo "${SCORE_OUT}"

if [[ "${SCORE_OUT}" == *"skipped=cpu-kernel"* ]]; then
  echo "cpu-kernel was skipped in executor image: ${SCORE_OUT}" >&2
  exit 1
fi

if [[ "${SCORE_OUT}" != *"kernel-check vxpu::fp8_linear cpu-kernel"* ]]; then
  echo "expected cpu-kernel to be scored in executor image, got output: ${SCORE_OUT}" >&2
  exit 1
fi

LAST_LINE="$(echo "${SCORE_OUT}" | tail -n 1 | tr -d '[:space:]')"
if ! awk "BEGIN {exit !(${LAST_LINE} > 0)}" 2>/dev/null; then
  echo "Kernel score last line must be a positive number, got: ${LAST_LINE}" >&2
  exit 1
fi
echo "Kernel score: ${LAST_LINE}"
