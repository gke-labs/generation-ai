set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# Check out the pinned deepseek_v41 submodule for tests that use tiny DeepSeek.
git submodule update --init vxpu/third_party/deepseek_v41

# Fail if the model source is absent instead of skipping tests that need it.
if [ ! -f "vxpu/third_party/deepseek_v41/inference/model.py" ]; then
  echo "Error: deepseek_v41 model source is absent (expected at vxpu/third_party/deepseek_v41/inference/model.py)" >&2
  exit 1
fi

# Add Python 3.13 from the runner toolcache to PATH when present.
if [ -d /opt/hostedtoolcache/Python ]; then
  PY313="$(find /opt/hostedtoolcache/Python -maxdepth 2 -type d -name "3.13.*" 2>/dev/null | sort -V | tail -n 1)"
  if [ -n "${PY313}" ] && [ -d "${PY313}/x64/bin" ]; then
    export PATH="${PY313}/x64/bin:${PATH}"
  fi
fi

# Read the torch pin from vxpu/images/executor/Dockerfile so both environments stay in sync.
# The executor image and this runner job must use the same torch version.
TORCH_VERSION="$(sed -n 's/.*torch==\([0-9.]*\).*/\1/p' vxpu/images/executor/Dockerfile)"
if [ -z "${TORCH_VERSION}" ]; then
  echo "no torch pin found in vxpu/images/executor/Dockerfile" >&2
  exit 1
fi

export PIP_BREAK_SYSTEM_PACKAGES=1
export UV_CACHE_DIR="${REPO_ROOT}/.cache/uv"

# Install uv until ap or the runner image provides it.
pip install uv

if [ ! -d .venv ]; then
  uv venv
fi
source .venv/bin/activate

uv pip install --index-url https://download.pytorch.org/whl/cpu "torch==${TORCH_VERSION}"
uv pip install -e vxpu/python

# Require model source for tests that need it; tests will fail rather than skip.
export VXPU_REQUIRE_MODEL_SOURCE="1"

# Do not write bytecode into submodules and unbuffer test output.
export PYTHONDONTWRITEBYTECODE="1"
export PYTHONUNBUFFERED="1"

# Run test discovery from the repository root.
# The test runner prints each test as it starts and summarizes skipped tests with their reasons.
# Tests that need C++ CPU kernels must build them in the job or skip with a reason that names them.
python -u dev/ci/test_runner.py

# Run acceptance test from the agent through the process table to a built package.
# In this job a skip or failure is fatal.
if ! (cd "${REPO_ROOT}/vxpu" && go test -v -count=1 -run TestCompilerServingOverGRPC ./pkg/agent) > /tmp/compiler_test.out 2>&1; then
  cat /tmp/compiler_test.out
  echo "Error: TestCompilerServingOverGRPC did not pass" >&2
  exit 1
fi
cat /tmp/compiler_test.out
if ! grep -F -q -e "--- PASS: TestCompilerServingOverGRPC" /tmp/compiler_test.out; then
  echo "Error: TestCompilerServingOverGRPC did not pass" >&2
  exit 1
fi
rm -f /tmp/compiler_test.out

# Run acceptance test for CompilerClient through real agent and service to built package and failure.
# In this job a skip or failure is fatal.
if ! (cd "${REPO_ROOT}/vxpu" && go test -v -count=1 -run TestCompilerClient ./pkg/kernelplan) > /tmp/compiler_client_test.out 2>&1; then
  cat /tmp/compiler_client_test.out
  echo "Error: TestCompilerClient did not pass" >&2
  exit 1
fi
cat /tmp/compiler_client_test.out
if ! grep -F -q -e "--- PASS: TestCompilerClient_ThroughRealAgentAndService" /tmp/compiler_client_test.out; then
  echo "Error: TestCompilerClient_ThroughRealAgentAndService did not pass" >&2
  exit 1
fi
rm -f /tmp/compiler_client_test.out

# Run acceptance test for vxpu plan packages --build through real agent and service.
# In this job a skip or failure is fatal.
if ! (cd "${REPO_ROOT}/vxpu" && go test -v -count=1 -run TestCmdPlanPackages_Build ./cmd/vxpu) > /tmp/plan_packages_build_test.out 2>&1; then
  cat /tmp/plan_packages_build_test.out
  echo "Error: TestCmdPlanPackages_Build did not pass" >&2
  exit 1
fi
cat /tmp/plan_packages_build_test.out
if ! grep -F -q -e "--- PASS: TestCmdPlanPackages_BuildThroughService" /tmp/plan_packages_build_test.out; then
  echo "Error: TestCmdPlanPackages_BuildThroughService did not pass" >&2
  exit 1
fi
rm -f /tmp/plan_packages_build_test.out

# Run acceptance test for segment reads and writes invariants on tiny DeepSeek and tiny Llama.
# In this job a skip or failure is fatal.
if ! (cd "${REPO_ROOT}/vxpu" && go test -v -count=1 -run "TestReadSegments_ReadsWrites_Tiny" ./pkg/kernelplan) > /tmp/reads_writes_test.out 2>&1; then
  cat /tmp/reads_writes_test.out
  echo "Error: TestReadSegments_ReadsWrites_Tiny did not pass" >&2
  exit 1
fi
cat /tmp/reads_writes_test.out
if ! grep -F -q -e "--- PASS: TestReadSegments_ReadsWrites_TinyDeepSeek" /tmp/reads_writes_test.out || \
   ! grep -F -q -e "--- PASS: TestReadSegments_ReadsWrites_TinyLlama" /tmp/reads_writes_test.out; then
  echo "Error: TestReadSegments_ReadsWrites_Tiny skipped or did not pass" >&2
  exit 1
fi
rm -f /tmp/reads_writes_test.out

# Pin pyright version so upstream releases do not break unrelated PRs; bump in its own change.
uv pip install "pyright==1.1.414"
pyright -p vxpu/python
