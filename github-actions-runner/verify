set -o errexit
set -o nounset
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CHART_VERSION="0.15.1"
CONTROLLER_CHART="oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set-controller"
RUNNER_SET_CHART="oci://ghcr.io/actions/actions-runner-controller-charts/gha-runner-scale-set"

echo "Rendering gha-runner-scale-set-controller chart..."
CONTROLLER_RENDER="$(helm template arc "${CONTROLLER_CHART}" \
  --version "${CHART_VERSION}" \
  --namespace arc-systems \
  -f "${SCRIPT_DIR}/values-controller.yaml")"

# Verify no ClusterRoles are created when watchSingleNamespace is set.
if echo "${CONTROLLER_RENDER}" | grep -q "kind: ClusterRole"; then
  echo "ERROR: controller template rendered ClusterRole despite watchSingleNamespace" >&2
  exit 1
fi
echo "Controller RBAC: namespaced Roles only (no ClusterRoles)."

echo "Rendering gha-runner-scale-set chart..."
RUNNER_RENDER="$(helm template vxpu-gpu-l4 "${RUNNER_SET_CHART}" \
  --version "${CHART_VERSION}" \
  --namespace arc-runners \
  -f "${SCRIPT_DIR}/values-runner-set.yaml")"

# Verify required securityContext, nodeSelector, and emptyDir hardening.
echo "${RUNNER_RENDER}" | grep -q "automountServiceAccountToken" || (echo "ERROR: missing automountServiceAccountToken" >&2 && exit 1)
echo "${RUNNER_RENDER}" | grep -q "runAsNonRoot" || (echo "ERROR: missing runAsNonRoot" >&2 && exit 1)
echo "${RUNNER_RENDER}" | grep -q "allowPrivilegeEscalation" || (echo "ERROR: missing allowPrivilegeEscalation" >&2 && exit 1)
echo "${RUNNER_RENDER}" | grep -q "sizeLimit: 30Gi" || (echo "ERROR: missing emptyDir sizeLimit" >&2 && exit 1)

echo "Hardened runner pod fields confirmed:"
echo "${RUNNER_RENDER}" | grep -E "automountServiceAccountToken|runAsNonRoot|allowPrivilegeEscalation|sizeLimit|generation-ai.gke.io/runner"

echo "All Helm templates rendered and verified successfully."
