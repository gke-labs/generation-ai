set -o errexit
set -o nounset
set -o pipefail

# Goal commands run from arbitrary working directories in automated sandboxes;
# locate the repository root so PYTHONPATH and .venv resolve correctly.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "${REPO_ROOT}"

if [ -f "${REPO_ROOT}/.venv/bin/activate" ]; then
  # shellcheck source=/dev/null
  source "${REPO_ROOT}/.venv/bin/activate"
fi

export PYTHONPATH="${REPO_ROOT}/vxpu/python${PYTHONPATH:+:${PYTHONPATH}}"

CARD="$(python -c "import torch; print(torch.cuda.get_device_name(0) if torch.cuda.is_available() and torch.cuda.device_count() > 0 else '')" 2>/dev/null || true)"
if [ -z "${CARD}" ]; then
  echo "kernel-score: CUDA requested but no CUDA-capable card is available" >&2
  exit 1
fi

BW=""
LOOKUP_ERR=""

if command -v vxpu >/dev/null 2>&1; then
  ERR_FILE="$(mktemp)"
  if BW="$(vxpu machines --card "${CARD}" 2>"${ERR_FILE}")"; then
    rm -f "${ERR_FILE}"
  else
    LOOKUP_ERR="$(cat "${ERR_FILE}")"
    rm -f "${ERR_FILE}"
    BW=""
  fi
fi

if [ -z "${BW}" ] && command -v go >/dev/null 2>&1; then
  ERR_FILE="$(mktemp)"
  if BW="$( (cd "${REPO_ROOT}/vxpu" && go run ./cmd/vxpu machines --card "${CARD}") 2>"${ERR_FILE}")"; then
    rm -f "${ERR_FILE}"
  else
    LOOKUP_ERR="$(cat "${ERR_FILE}")"
    rm -f "${ERR_FILE}"
    BW=""
  fi
fi

if [ -z "${BW}" ]; then
  if [ -n "${LOOKUP_ERR}" ]; then
    echo "gpu-kernel-score: ${LOOKUP_ERR}" >&2
  else
    echo "gpu-kernel-score: cannot look up bandwidth for card \"${CARD}\" (requires vxpu binary or go toolchain)" >&2
  fi
  exit 1
fi

exec python -m vxpu.kernels.score --device cuda --card "${CARD}" --bandwidth-gb-s "${BW}" "$@"
