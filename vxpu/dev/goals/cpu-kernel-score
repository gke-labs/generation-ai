set -o errexit
set -o nounset
set -o pipefail

# Goal commands run from arbitrary working directories in automated sandboxes;
# locate the repository root so PYTHONPATH and .venv resolve correctly.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)"
cd "${REPO_ROOT}"

if [ -f "${REPO_ROOT}/.venv/bin/activate" ]; then
  # shellcheck source=/dev/null
  source "${REPO_ROOT}/.venv/bin/activate"
fi

export PYTHONPATH="${REPO_ROOT}/vxpu/python${PYTHONPATH:+:${PYTHONPATH}}"

exec python -m vxpu.kernels.score --device cpu "$@"
