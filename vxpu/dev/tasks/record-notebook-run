"""Record a notebook run as a replayable HTML page (no browser, no video).

Executes the notebook with nbclient (what `jupyter nbconvert --execute`
uses) and logs every kernel message — execute_input, stream chunks,
results, errors, busy/idle — with the time it arrived. Streamed output
such as a TextStreamer printing one token at a time keeps its real
cadence. The result is:

    <name>.recording.json   the stripped cells plus the timestamped events
    <name>.html             a self-contained player: cells rendered like a
                            notebook, outputs appear on schedule, with
                            play/pause, speed, idle-gap capping (a
                            12-minute model load becomes seconds) and a
                            scrubber

    .venv/bin/python dev/tasks/record-notebook-run examples/gemma4/gemma4-on-vxpu.ipynb

A few kilobytes of text per run, so recordings can be diffed and
hosted anywhere a static file can. Requires nbclient, nbformat,
mistune and pygments (all dependencies of jupyter/nbconvert); the
notebook's own requirements apply as usual.
"""

import argparse
import datetime
import html
import json
import os
import re
import sys
import time

import mistune
import nbformat
from nbclient import NotebookClient
from nbclient.exceptions import CellExecutionError, CellTimeoutError, DeadKernelError
from pygments import highlight
from pygments.formatters import HtmlFormatter
from pygments.lexers import PythonLexer

# CSI sequences and OSC strings; \r and \b are kept for the player, which
# applies them the way a notebook output area does.
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
MARKDOWN = mistune.create_markdown(plugins=["table", "strikethrough"])
FORMATTER = HtmlFormatter(nowrap=True)
DEFAULT_OUT = os.path.join(os.path.expanduser("~"), ".cache", "vxpu", "recordings")


def strip_ansi(text):
    return ANSI.sub("", text)


def render_mime(data):
    """Pick the richest representation the player can show."""
    if "text/html" in data:
        return {"html": "".join(data["text/html"])}
    if "text/markdown" in data:
        return {"html": MARKDOWN("".join(data["text/markdown"]))}
    if "image/png" in data:
        return {"html": f'<img src="data:image/png;base64,{data["image/png"]}">'}
    if "text/plain" in data:
        return {"html": f"<pre>{html.escape(strip_ansi(''.join(data['text/plain'])))}</pre>"}
    return {"html": f"<pre>{html.escape(', '.join(sorted(data)))}</pre>"}


class RecordingClient(NotebookClient):
    """nbclient that logs every kernel message with a timestamp."""

    def __init__(self, nb, events, **kwargs):
        super().__init__(nb, **kwargs)
        self._events = events
        self._t0 = time.monotonic()

    def process_message(self, msg, cell, cell_index):
        content = msg["content"]
        kind = msg["msg_type"]
        event = None
        if kind == "execute_input":
            event = {"type": "input", "count": content.get("execution_count")}
        elif kind == "stream":
            event = {"type": "stream", "name": content["name"],
                     "text": strip_ansi(content["text"])}
        elif kind in ("execute_result", "display_data", "update_display_data"):
            event = {"type": "update" if kind == "update_display_data" else "display",
                     **render_mime(content.get("data", {}))}
            display_id = (content.get("transient") or {}).get("display_id")
            if display_id:
                event["display_id"] = display_id
        elif kind == "error":
            event = {"type": "error", "text": strip_ansi(
                "\n".join(content.get("traceback", [])) or
                f"{content.get('ename')}: {content.get('evalue')}")}
        elif kind == "clear_output":
            # wait=True clears only when the next output arrives (the
            # flicker-free refresh idiom); the player honours it.
            event = {"type": "clear", "wait": bool(content.get("wait"))}
        elif kind == "status":
            event = {"type": "status", "state": content["execution_state"]}
        if event is not None:
            event["t"] = round(time.monotonic() - self._t0, 3)
            event["cell"] = cell_index
            self._events.append(event)
        return super().process_message(msg, cell, cell_index)


def record(path, timeout, kernel_name, allow_errors):
    nb = nbformat.read(path, as_version=4)
    events = []
    kernel = kernel_name or nb.metadata.get("kernelspec", {}).get("name", "python3")
    client = RecordingClient(
        nb, events, timeout=timeout, kernel_name=kernel,
        allow_errors=allow_errors,
        resources={"metadata": {"path": os.path.dirname(os.path.abspath(path)) or "."}})
    started = datetime.datetime.now(datetime.timezone.utc)
    aborted = None
    try:
        client.execute()
    except (CellExecutionError, CellTimeoutError, DeadKernelError,
            KeyboardInterrupt) as e:
        # Keep what was recorded: a late failure in a long run is
        # exactly when the recording is most useful.
        detail = strip_ansi(str(e)).strip().splitlines()
        aborted = f"{type(e).__name__}: {detail[-1] if detail else ''}"
        print(f"run aborted ({aborted}); writing the partial recording",
              file=sys.stderr)
    cells = []
    for i, cell in enumerate(nb.cells):
        source = "".join(cell.source)
        if cell.cell_type == "markdown":
            cells.append({"type": "markdown", "html": MARKDOWN(source)})
        elif cell.cell_type == "code":
            cells.append({"type": "code", "source": source,
                          "html": highlight(source, PythonLexer(), FORMATTER)})
        else:
            cells.append({"type": "raw", "html": f"<pre>{html.escape(source)}</pre>"})
    duration = events[-1]["t"] if events else 0.0
    errors = sum(1 for e in events if e["type"] == "error")
    return {
        "format": "vxpu-notebook-recording/v1",
        "notebook": os.path.basename(path),
        "recorded": started.isoformat(timespec="seconds"),
        "duration": duration,
        "errors": errors,
        "aborted": aborted,
        "cells": cells,
        "events": events,
    }


ASSETS_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "notebook-player")


def load_asset(name):
    path = os.path.join(ASSETS_DIR, name)
    with open(path, "r", encoding="utf-8") as f:
        return f.read()


def write_player(recording, path, shared_assets=None):
    aborted = recording.get("aborted")
    page = load_asset("player.html")

    if shared_assets is not None:
        prefix = shared_assets.rstrip("/")
        css_tag = f'<link rel="stylesheet" href="{prefix}/player.css">' if prefix else '<link rel="stylesheet" href="player.css">'
        js_tag = f'<script src="{prefix}/player.js"></script>' if prefix else '<script src="player.js"></script>'
    else:
        css = load_asset("player.css")
        js = load_asset("player.js")
        css_tag = f"<style>\n{css}\n</style>"
        js_tag = f"<script>\n{js}\n</script>"

    if '<link rel="stylesheet" href="player.css">' in page:
        page = page.replace('<link rel="stylesheet" href="player.css">', css_tag)
    elif "__STYLE__" in page:
        page = page.replace("__STYLE__", css_tag)

    if '<script src="player.js"></script>' in page:
        page = page.replace('<script src="player.js"></script>', js_tag)
    elif "__SCRIPT__" in page:
        page = page.replace("__SCRIPT__", js_tag)

    duration_mins = int(recording["duration"] // 60)
    duration_secs = int(recording["duration"] % 60)
    duration_str = f"{duration_mins}m{duration_secs:02d}s"
    aborted_str = f' <span class="meta" style="color:#b3261e">· aborted: {html.escape(aborted)}</span>' if aborted else ""

    page = (page
            .replace("__TITLE__", html.escape(recording["notebook"]))
            .replace("__RECORDED__", html.escape(recording["recorded"]))
            .replace("__DURATION__", duration_str)
            .replace("__ABORTED__", aborted_str)
            # \u003c keeps "</script>" and "<!--" in recorded content from
            # ending or escaping the data element.
            .replace("__RECORDING__", json.dumps(recording).replace("<", "\\u003c")))
    with open(path, "w", encoding="utf-8") as f:
        f.write(page)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("notebook")
    parser.add_argument("--out", default=DEFAULT_OUT,
                        help="output directory (default: a per-user cache dir)")
    parser.add_argument("--timeout", type=int, default=3600, help="per-cell timeout")
    parser.add_argument("--kernel", default=None, help="kernel name (default: the notebook's)")
    parser.add_argument("--stop-on-error", action="store_true",
                        help="stop at the first failing cell (the recording up to "
                             "and including it is still written)")
    parser.add_argument("--shared-assets", default=None, metavar="URL",
                        help="URL prefix for shared player.css and player.js instead of inlining")
    args = parser.parse_args()

    # Fail on an unusable output directory before the (possibly long) run.
    os.makedirs(args.out, exist_ok=True)
    stem = os.path.join(args.out, os.path.splitext(os.path.basename(args.notebook))[0])
    recording = record(args.notebook, args.timeout, args.kernel,
                       allow_errors=not args.stop_on_error)
    with open(stem + ".recording.json", "w", encoding="utf-8") as f:
        json.dump(recording, f)
    write_player(recording, stem + ".html", shared_assets=args.shared_assets)
    print(f"recording: {stem}.recording.json ({len(recording['events'])} events, "
          f"{recording['duration']:.0f}s real time, {recording['errors']} errors"
          f"{', aborted' if recording['aborted'] else ''})")
    print(f"player:    {stem}.html")
    return 1 if recording["errors"] or recording["aborted"] else 0


if __name__ == "__main__":
    sys.exit(main())
