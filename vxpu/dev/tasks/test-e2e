set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(env -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_SYSTEM git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

# Ensure submodule is checked out before installing
env -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_SYSTEM git submodule update --init vxpu/third_party/transformers

# Install client-side Python dependencies (torch, transformers fork, vxpu)
# for the facade equivalence e2e test into .venv.
TORCH_VERSION="$(sed -n 's/.*torch==\([0-9.]*\).*/\1/p' vxpu/images/executor/Dockerfile)"
if [ -z "${TORCH_VERSION}" ]; then
  echo "no torch pin found in vxpu/images/executor/Dockerfile" >&2
  exit 1
fi

export PIP_BREAK_SYSTEM_PACKAGES=1
export UV_CACHE_DIR="${REPO_ROOT}/.cache/uv"

if ! command -v uv >/dev/null 2>&1; then
  pip install uv
fi

VENV_DIR="${REPO_ROOT}/.venv"
if [ ! -d "${VENV_DIR}" ]; then
  uv venv "${VENV_DIR}"
fi

uv pip install -p "${VENV_DIR}" --index-url https://download.pytorch.org/whl/cpu "torch==${TORCH_VERSION}"
uv pip install -p "${VENV_DIR}" -e vxpu/third_party/transformers
uv pip install -p "${VENV_DIR}" -e vxpu/python

# Fetch the test model once into the local mirror cache with retries so e2e
# tests serve it over HTTP without reaching huggingface.co during execution.
"${VENV_DIR}/bin/python" "${REPO_ROOT}/dev/ci/hf_mirror.py" fetch \
  --cache-dir "${REPO_ROOT}/.cache/hf-mirror"
